{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fwpanel",
  "version": "0.1.0",
  "identifier": "io.github.singh-gur.fwpanel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "fwpanel",
        "width": 1000,
        "height": 760,
        "minWidth": 560,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Control panel for Framework laptops",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "epoch": 0,
        "release": "1",
        "depends": [
          "fwpanel-service-api-1",
          "webkit2gtk4.1",
          "gtk3"
        ],
        "desktopTemplate": "../packaging/fwpanel.desktop.hbs",
        "files": {
          "/usr/share/metainfo/io.github.singh-gur.fwpanel.metainfo.xml": "../packaging/io.github.singh-gur.fwpanel.metainfo.xml"
        }
      }
    }
  }
}
